# Токен бота від @BotFather (ніколи не надсилайте його в чат)
BOT_TOKEN=
# Ключ OpenAI (platform.openai.com → API keys)
OPENAI_API_KEY=
# Telegram ID власника (бот покаже його на /start)
OWNER_TELEGRAM_ID=
# ID групи LEVEL NINE | ADMIN (бот покаже його командою /chatid у групі)
ADMIN_CHAT_ID=
# Необов'язково
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MONTHLY_LIMIT_USD=10
DAILY_REPORT_TIME=22:30
BACKUP_TIME=03:30
DATA_DIR=./data
TZ_NAME=Europe/Kyiv
